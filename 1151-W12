<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>1151-W12 BNA-EMI | BNA Agent SPA</title>
  <style>
    :root {
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --accent-blue: #0284c7;
      --accent-blue-bg: #e0f2fe;
      --accent-green: #16a34a;
      --accent-green-bg: #dcfce7;
      --accent-orange: #ea580c;
      --accent-orange-bg: #ffedd5;
      --accent-red: #e11d48;
      --accent-red-bg: #ffe4e6;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    body {
      background-color: #e2e8f0;
      color: var(--text-main);
      display: flex;
      justify-content: center;
      min-height: 100vh;
    }

    /* Portrait Mobile-First Container (符合筆記 in portrait 規範) */
    .app-container {
      width: 100%;
      max-width: 480px;
      background-color: var(--bg-color);
      min-height: 100vh;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      display: flex;
      flex-direction: column;
    }

    header {
      background-color: var(--card-bg);
      padding: 20px 16px 14px;
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      color: var(--accent-blue);
      background: var(--accent-blue-bg);
      padding: 3px 8px;
      border-radius: 12px;
      margin-bottom: 6px;
    }

    h1 {
      font-size: 20px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.3;
    }

    .subtitle {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    /* SPA Navigation Tabs */
    .nav-tabs {
      display: flex;
      background: var(--card-bg);
      border-bottom: 1px solid var(--border-color);
      padding: 0 12px;
    }

    .tab-btn {
      flex: 1;
      padding: 12px 4px;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }

    .tab-btn.active {
      color: var(--accent-blue);
      border-bottom-color: var(--accent-blue);
    }

    main {
      padding: 16px;
      flex: 1;
    }

    .tab-content {
      display: none;
      animation: fadeIn 0.25s ease;
    }

    .tab-content.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 14px;
    }

    .card-title {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .step-list {
      list-style: none;
    }

    .step-item {
      padding: 8px 0;
      border-bottom: 1px dashed var(--border-color);
      font-size: 14px;
      line-height: 1.5;
    }

    .step-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .step-num {
      display: inline-block;
      width: 20px;
      height: 20px;
      background: var(--accent-blue-bg);
      color: var(--accent-blue);
      font-weight: 700;
      font-size: 12px;
      text-align: center;
      line-height: 20px;
      border-radius: 50%;
      margin-right: 6px;
    }

    .tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;
    }

    .tag {
      font-size: 12px;
      padding: 4px 10px;
      border-radius: 6px;
      background: #f1f5f9;
      color: #334155;
      font-weight: 500;
    }

    /* SVG Diagram Container */
    .svg-box {
      width: 100%;
      background: #ffffff;
      border-radius: 8px;
      padding: 8px 0;
      text-align: center;
    }

    /* Checklist for Handoff */
    .check-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 8px 0;
      font-size: 14px;
      cursor: pointer;
    }

    .check-item input[type="checkbox"] {
      margin-top: 3px;
      width: 16px;
      height: 16px;
      accent-color: var(--accent-green);
    }

    .checked-text {
      text-decoration: line-through;
      color: var(--text-muted);
    }

    footer {
      text-align: center;
      padding: 16px;
      font-size: 12px;
      color: var(--text-muted);
      border-top: 1px solid var(--border-color);
      background: var(--card-bg);
    }
  </style>
</head>
<body>

<div class="app-container">
  <header>
    <span class="badge">1151-W12 BNA-EMI</span>
    <h1>BNA Agent & Analytical Thinking</h1>
    <p class="subtitle">In-Class Note SPA • Simple, Clear & Light Colored</p>
  </header>

  <nav class="nav-tabs">
    <button class="tab-btn active" onclick="switchTab('kb', this)">KB.md 知識庫</button>
    <button class="tab-btn" onclick="switchTab('prd', this)">PRD.md 規格</button>
    <button class="tab-btn" onclick="switchTab('handoff', this)">Handoff 交接</button>
  </nav>

  <main>
    <!-- TAB 1: KB.md -->
    <div id="tab-kb" class="tab-content active">
      
      <!-- SVG Diagram (符合筆記 .svg 要求) -->
      <div class="card">
        <div class="card-title">
          <span class="dot" style="background: var(--accent-green);"></span>
          AI Note-to-Deploy Workflow (.svg)
        </div>
        <div class="svg-box">
          <svg viewBox="0 0 360 155" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg">
            <!-- Step 1 -->
            <rect x="8" y="15" width="96" height="52" rx="8" fill="#dcfce7" stroke="#16a34a" stroke-width="1.5"/>
            <text x="56" y="38" font-size="11" font-weight="bold" text-anchor="middle" fill="#166534">In-Class Note</text>
            <text x="56" y="54" font-size="9" text-anchor="middle" fill="#15803d">Handwritten / Img</text>

            <!-- Arrow 1 -->
            <path d="M 108 41 L 128 41" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow)"/>

            <!-- Step 2 -->
            <rect x="132" y="15" width="96" height="52" rx="8" fill="#e0f2fe" stroke="#0284c7" stroke-width="1.5"/>
            <text x="180" y="38" font-size="11" font-weight="bold" text-anchor="middle" fill="#075985">Task Agent</text>
            <text x="180" y="54" font-size="9" text-anchor="middle" fill="#0369a1">KB / PRD (.md)</text>

            <!-- Arrow 2 -->
            <path d="M 232 41 L 252 41" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow)"/>

            <!-- Step 3 -->
            <rect x="256" y="15" width="96" height="52" rx="8" fill="#ffedd5" stroke="#ea580c" stroke-width="1.5"/>
            <text x="304" y="38" font-size="11" font-weight="bold" text-anchor="middle" fill="#9a3412">Coding Agent</text>
            <text x="304" y="54" font-size="9" text-anchor="middle" fill="#c2410c">SPA (.html)</text>

            <!-- Down Arrow -->
            <path d="M 304 71 L 304 92" stroke="#64748b" stroke-width="1.5" marker-end="url(#arrow)"/>

            <!-- Step 4: Deploy -->
            <rect x="132" y="96" width="220" height="44" rx="8" fill="#ffe4e6" stroke="#e11d48" stroke-width="1.5"/>
            <text x="242" y="116" font-size="11" font-weight="bold" text-anchor="middle" fill="#9f1239">Deploy 部署 &rarr; Deployment URL</text>
            <text x="242" y="131" font-size="9" text-anchor="middle" fill="#be123c">http:// web link (Effective Goal Reached)</text>

            <!-- Market/Creativity Note -->
            <rect x="8" y="96" width="112" height="44" rx="8" fill="#f1f5f9" stroke="#94a3b8" stroke-width="1"/>
            <text x="64" y="116" font-size="10" font-weight="bold" text-anchor="middle" fill="#334155">Human Core</text>
            <text x="64" y="130" font-size="9" text-anchor="middle" fill="#475569">Creativity &amp; Critical</text>

            <defs>
              <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M 0 1 L 10 5 L 0 9 z" fill="#64748b"/>
              </marker>
            </defs>
          </svg>
        </div>
      </div>

      <!-- Analytical Thinking -->
      <div class="card">
        <div class="card-title">
          <span class="dot" style="background: var(--accent-blue);"></span>
          Analytical Thinking（分析性思考 4 步驟）
        </div>
        <ul class="step-list">
          <li class="step-item"><span class="step-num">1</span><strong>Separate（拆解）：</strong>將 Problem、Demand、Question 拆解為多個部分（&Sigma; parts / components）。</li>
          <li class="step-item"><span class="step-num">2</span><strong>Investigate（深入調查）：</strong>尋找證據（with evidences）並挖掘潛在關聯（potential relationships）。</li>
          <li class="step-item"><span class="step-num">3</span><strong>Recombine（重組）：</strong>重新結構化整合資訊。</li>
          <li class="step-item"><span class="step-num">4</span><strong>Insights（洞察）：</strong>產出新的表現形式（A new representation）。</li>
        </ul>
      </div>

      <!-- Mind Map & Style -->
      <div class="card">
        <div class="card-title">
          <span class="dot" style="background: var(--accent-red);"></span>
          Mind Map 與視覺設計原則
        </div>
        <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 8px;">
          Coggle Mind Map 核心：<strong>Systematic（系統化）、Structured（結構化）、Process-oriented（流程導向）</strong>。
        </p>
        <div class="tag-row">
          <span class="tag" style="background: var(--accent-green-bg); color: #166534;">&#9989; In Portrait（直向手機優先）</span>
          <span class="tag" style="background: var(--accent-red-bg); color: #9f1239;">&#10060; Landscape（橫向）</span>
          <span class="tag">Simple 簡潔</span>
          <span class="tag">Clear 清晰</span>
          <span class="tag">Light Colored 淺色系</span>
          <span class="tag" style="background: var(--accent-blue-bg); color: #075985;">Effective（目標達成）</span>
        </div>
      </div>

    </div>

    <!-- TAB 2: PRD.md -->
    <div id="tab-prd" class="tab-content">
      <div class="card">
        <div class="card-title">
          <span class="dot" style="background: var(--accent-orange);"></span>
          Market &amp; MVP（市場與最小可行性產品）
        </div>
        <ul class="step-list">
          <li class="step-item"><strong>Market 互動：</strong>Producers（生產者）提供 Product 給 Consumers（消費者），創造商業交易價值（$）。</li>
          <li class="step-item"><strong>MVP 定義：</strong>Minimum Viable Product，具備可商業化交易的價值（Value / WTP 願付價格）與明確目標客群（TA）。</li>
          <li class="step-item"><strong>SaaS 架構：</strong>Software / APP / Webpage，包含 Front-end（前端介面）與 Back-end（後端邏輯）。</li>
        </ul>
      </div>

      <div class="card">
        <div class="card-title">
          <span class="dot" style="background: var(--accent-blue);"></span>
          BNA Agent 產品功能規格
        </div>
        <ul class="step-list">
          <li class="step-item"><strong>多模態輸入：</strong>支援課堂手寫筆記圖片、錄音、影片與討論摘要（Discussion / Consultancy）。</li>
          <li class="step-item"><strong>結構化文件輸出：</strong>自動產出 <code>KB.md</code>、<code>PRD.md</code> 與 <code>handoff.md</code>。</li>
          <li class="step-item"><strong>視覺圖表支援：</strong>支援 <code>.png</code> / <code>.jpeg</code> 與可縮放向量圖 <code>.svg</code>。</li>
          <li class="step-item"><strong>單頁式應用打包：</strong>轉換為 <code>.html</code> (SPA) 並部署產生公開網址。</li>
        </ul>
      </div>
    </div>

    <!-- TAB 3: handoff.md -->
    <div id="tab-handoff" class="tab-content">
      <div class="card">
        <div class="card-title">
          <span class="dot" style="background: var(--accent-green);"></span>
          Team Session &amp; Deployment 檢查清單
        </div>
        <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 10px;">
          Team Member #1 &amp; #2 協作交接與 GitHub Pages 部署進度（點擊可勾選）：
        </p>
        <label class="check-item">
          <input type="checkbox" checked onchange="toggleCheck(this)">
          <span class="checked-text">完成 1151-W12 手寫筆記拆解與結構化整理</span>
        </label>
        <label class="check-item">
          <input type="checkbox" checked onchange="toggleCheck(this)">
          <span class="checked-text">建立 GitHub Repository 並新增 KB.md / PRD.md</span>
        </label>
        <label class="check-item">
          <input type="checkbox" onchange="toggleCheck(this)">
          <span>上傳單頁式應用程式 <code>index.html</code> (SPA)</span>
        </label>
        <label class="check-item">
          <input type="checkbox" onchange="toggleCheck(this)">
          <span>前往 GitHub Settings &rarr; Pages 開啟部署</span>
        </label>
        <label class="check-item">
          <input type="checkbox" onchange="toggleCheck(this)">
          <span>取得公開 Deployment URL 並使用手機直向測試</span>
        </label>
      </div>
    </div>
  </main>

  <footer>
    BNA-EMI W12 (11/25'26) • Built for Mobile Portrait View
  </footer>
</div>

<script>
  function switchTab(tabId, btn) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
    document.getElementById('tab-' + tabId).classList.add('active');
    btn.classList.add('active');
  }

  function toggleCheck(checkbox) {
    const textSpan = checkbox.nextElementSibling;
    if (checkbox.checked) {
      textSpan.classList.add('checked-text');
    } else {
      textSpan.classList.remove('checked-text');
    }
  }
</script>

</body>
</html>
